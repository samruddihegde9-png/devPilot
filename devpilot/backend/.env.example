# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# A local Postgres instance (see docker-compose.yml at the repo root).
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@localhost:5432/devpilot

# --- Workspaces ---
# Leave unset to default to ../workspaces relative to the backend package.
# WORKSPACES_ROOT=/absolute/path/to/workspaces

# --- LLM provider (used starting Phase 2 — not required for Phase 1) ---
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2:1b
OPENAI_BASE_URL=http://localhost:11434/v1
# --- Agent limits (used starting Phase 2-4) ---
AGENT_MAX_DEBUG_ITERATIONS=5
COMMAND_TIMEOUT_SECONDS=30
MAX_OUTPUT_BYTES=200000
